{
  "env_file": "/etc/dbtool/dbtool.env",

  "defaults": {
    "backup_dir": "/backup/db",
    "log_file": "/var/log/dbtool.log",
    "retention_days": 14,
    "retention_min_keep": 3,
    "compression": "zstd",
    "pg_compress_level": 6,
    "format": "custom",
    "jobs": 4,
    "docker": "auto",
    "docker_network": "host",
    "timeout": 7200,
    "timestamp_format": "%Y%m%d-%H%M%S",
    "verify": "full",
    "include_globals": true,
    "lock": true
  },

  "s3": {
    "enabled": false,
    "provider": "mc",
    "alias": "minio",
    "bucket": "db-backups",
    "prefix": "db01"
  },

  "notify": {
    "webhook": ""
  },

  "databases": [
    {
      "name": "app_dev",
      "url": "postgresql+asyncpg://app_user:${APP_PG_PASSWORD}@${DB_HOST}:5432/app_dev"
    },
    {
      "name": "app_prod",
      "engine": "postgres",
      "host": "db-primary.example.com",
      "port": 5432,
      "user": "app_user",
      "password_env": "APP_PG_PASSWORD",
      "database": "app_prod",
      "sslmode": "prefer",
      "format": "custom",
      "no_owner": true,
      "exclude_tables": ["audit_log", "celery_taskmeta"],
      "dump_args": ["--no-privileges"]
    },
    {
      "name": "analytics_pg",
      "engine": "postgres",
      "host": "db-analytics.example.com",
      "port": 5432,
      "user": "postgres",
      "password_file": "/etc/dbtool/analytics.pass",
      "database": "analytics",
      "format": "directory",
      "jobs": 6
    },
    {
      "name": "crm_mysql",
      "engine": "mysql",
      "host": "db-primary.example.com",
      "port": 3306,
      "user": "crm_user",
      "password": "${CRM_DB_PASSWORD}",
      "database": "crm_mysql",
      "dump_args": ["--single-transaction", "--routines", "--triggers", "--events"]
    },
    {
      "name": "legacy_mysql",
      "engine": "mysql",
      "url": "mysql+pymysql://root:${LEGACY_MYSQL_PASSWORD}@db-legacy.example.com:3307/legacy_app",
      "enabled": false
    }
  ],

  "targets": {
    "staging_pg": {
      "engine": "postgres",
      "host": "db-analytics.example.com",
      "port": 5432,
      "user": "postgres",
      "password": "${STAGING_PG_PASSWORD}",
      "database": "app_dev",
      "create": true,
      "clean": false,
      "restore_args": ["--no-owner", "--no-privileges"]
    },
    "new_server_pg": {
      "engine": "postgres",
      "url": "postgresql://postgres:${NEW_PG_PASSWORD}@db-new.example.com:5432/app_prod",
      "create": true
    },
    "new_server_mysql": {
      "engine": "mysql",
      "host": "db-new.example.com",
      "port": 3306,
      "user": "root",
      "password": "${NEW_MYSQL_PASSWORD}",
      "database": "crm_mysql",
      "create": true
    }
  }
}
