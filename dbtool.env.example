# Secrets referenced from the config as ${VAR} or via password_env:.
# Copy to dbtool.env (or /etc/dbtool/dbtool.env), chmod 0600, and keep it out of git.
# Point at it with `env_file:` in the config, or source it before running dbtool.sh.

DB_HOST=db-primary.example.com

APP_PG_PASSWORD=change_me
CRM_DB_PASSWORD=change_me
LEGACY_MYSQL_PASSWORD=change_me
STAGING_PG_PASSWORD=change_me
NEW_PG_PASSWORD=change_me
NEW_MYSQL_PASSWORD=change_me
